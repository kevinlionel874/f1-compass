# Copy this file to .env.local and fill in your keys.

# Nebius Token Factory API key (join the Nebius Builder Program from the hackathon page for credits)
NEBIUS_API_KEY=

# Tavily API key: https://app.tavily.com
TAVILY_API_KEY=

# Optional. Run `npm run models` to see the exact NVIDIA model IDs your key can use.
# NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Set to 1 to stream canned sample data without calling any API (for UI work only).
MOCK_MODE=0
